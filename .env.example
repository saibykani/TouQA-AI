# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://touqa:touqa@localhost:5432/touqa
# Required to store integration credentials (Fernet key):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# App sign-in. First start creates this admin user when ADMIN_PASSWORD is set.
AUTH_ENABLED=true
ADMIN_EMAIL=admin@touqa.local
ADMIN_PASSWORD=
COOKIE_SECURE=false
# lax (default) | strict | none. Use none only if the UI and API are on different sites; needs COOKIE_SECURE=true.
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:5173

# AI provider: anthropic | openai_compatible | local | simulated
AI_PROVIDER=anthropic
AI_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
# For openai_compatible / local (e.g. Ollama: http://localhost:11434/v1)
AI_BASE_URL=
AI_API_KEY=
AI_EFFORT=high
ANTHROPIC_ENABLE_FALLBACKS=true

# Demo mode: synthetic data + simulated AI; external writes disabled
DEMO_MODE=false
DEMO_ALLOW_EXTERNAL_WRITES=false

# Integration network policy
VERIFY_TLS=true
ALLOW_PRIVATE_NETWORK_TARGETS=false
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=4

# Uploads
MAX_UPLOAD_BYTES=10485760

# Spira/Jira credentials are entered in Settings → Integrations (stored encrypted), not here.
